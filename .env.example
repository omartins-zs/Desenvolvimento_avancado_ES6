# ==============================================================================
# CONFIGURAÇÕES GERAIS DA APLICAÇÃO
# ==============================================================================
APP_NAME="Desenvolvimento Avançado ES6"
APP_ENV=local
APP_DEBUG=true
PORT=3000

# ==============================================================================
# MODO 1: EXECUÇÃO LOCAL (LARAGON / NODE.JS NATIVO) - ATIVO POR PADRÃO
# ==============================================================================
APP_URL=http://localhost:3000

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=es6_avancado
DB_USERNAME=root
DB_PASSWORD=

# ==============================================================================
# MODO 2: EXECUÇÃO DOCKER (CONTAINERS) - DESCOMENTE PARA USAR COM DOCKER
# ==============================================================================
# APP_URL=http://localhost:8080
#
# DB_CONNECTION=mysql
# DB_HOST=mysql
# DB_PORT=3306
# DB_DATABASE=es6_avancado
# DB_USERNAME=es6_user
# DB_PASSWORD=secret
# DB_ROOT_PASSWORD=root_secret

# ==============================================================================
# CREDENCIAIS DE DEMONSTRAÇÃO E TESTES
# ==============================================================================
DEMO_ADMIN_EMAIL=admin@es6.dev
DEMO_INSTRUTOR_EMAIL=instrutor@es6.dev
DEMO_DEV_EMAIL=dev@es6.dev
DEMO_DEFAULT_PASSWORD=Password@123
